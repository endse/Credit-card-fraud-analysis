# ==============================================================================
# FraudGuard AI — Global Environment Configuration Example
# Copy this file to .env and customize values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

# Allowed CORS origins (comma-separated, or * for development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SQLite Database Location
DB_PATH=backend/transactions.db

# Machine Learning Artifacts
ML_MODEL_PATH=backend/ml/artifacts/fraud_model.pkl
METRICS_PATH=backend/ml/artifacts/model_metrics.json

# Hybrid Risk Scoring Engine Parameters
# Final Score = (fraud_prob * ML_WEIGHT) + ((rule_points / max_rule_points) * RULE_WEIGHT)
ML_WEIGHT=70.0
RULE_WEIGHT=30.0

# Decision Thresholds
# 0 to APPROVE_THRESHOLD         -> APPROVE
# APPROVE_THRESHOLD + 1 to REVIEW_THRESHOLD -> REVIEW
# REVIEW_THRESHOLD + 1 to 100    -> BLOCK
APPROVE_THRESHOLD=29
REVIEW_THRESHOLD=69

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite requires VITE_ prefix for client exposure)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE="FraudGuard AI — Real-Time Fraud Detection Platform"
VITE_DEFAULT_CURRENCY=INR
VITE_ENABLE_ANALYTICS=true
VITE_TRANSACTION_LIMIT=100
