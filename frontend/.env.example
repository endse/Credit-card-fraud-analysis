# ==============================================================================
# FraudGuard AI — Frontend Web Console Environment Configuration
# Note: Vite exposes only variables prefixed with VITE_ to client bundle
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Application Title
VITE_APP_TITLE="FraudGuard AI — Real-Time Fraud Detection Platform"

# Default Currency Display (INR or USD)
VITE_DEFAULT_CURRENCY=INR

# Initial Historical Transactions Fetch Limit
VITE_TRANSACTION_LIMIT=100
