# ==============================================================================
# FraudGuard AI — Backend Service Environment Configuration
# ==============================================================================

# Server Network Settings
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

# Cross-Origin Resource Sharing (comma-separated list or *)
CORS_ORIGINS=*

# Database Persistence
DB_PATH=transactions.db

# Machine Learning Paths
ML_MODEL_PATH=../ml/artifacts/fraud_model.pkl
METRICS_PATH=../ml/artifacts/model_metrics.json

# Hybrid Engine Weighting (Must sum to 100)
ML_WEIGHT=70.0
RULE_WEIGHT=30.0

# Classification Thresholds
APPROVE_THRESHOLD=29
REVIEW_THRESHOLD=69
